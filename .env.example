# ============================================================
# .env.example — 環境変数の雛形 (これだけ git にコミットする)
# ============================================================
#
# 使い方:
#   1. このファイルを `.env.local` にコピー  → cp .env.example .env.local
#   2. `.env.local` に実値を書く            → .env.local は gitignore 済 (絶対 commit しない)
#   3. 本番/プレビューの値は Vercel env か `gh secret set <NAME>` に置く (このファイルやコードには書かない)
#
# 命名規約 (marketplace docs/conventions/env-naming.md):
#   フォーマット : [NEXT_PUBLIC_]<DOMAIN>_<KEY>   (UPPER_SNAKE_CASE)
#   NEXT_PUBLIC_*  … ブラウザに露出する。**秘密情報 (TOKEN/SECRET/PRIVATE_KEY) は絶対に入れない**
#   接頭辞なし     … サーバー専用 (Route Handler / Server Component / Server Action のみ参照可)
#
# 値はすべてプレースホルダ。実在のキー・URL・電話番号などは書かないこと。
# ここに無いキーは、各プラグインが必要時に追記する (追記したら env-naming.md の接頭辞表にも反映)。
# ------------------------------------------------------------


# --- アプリ共通 -------------------------------------------------
# 公開してよいアプリの公開 URL (OGP やリダイレクト先などに使う)
NEXT_PUBLIC_APP_URL="http://localhost:3000"


# --- AI 機能 (ai-feature / image-gen が使用) -------------------
# このプロジェクトは Vercel AI Gateway に集約する設計。プロバイダ別キー
# (ANTHROPIC_API_KEY 等) は持たず、AI_GATEWAY_API_KEY 1 つで Anthropic / OpenAI /
# Google(Gemini) / xAI に届く。プロバイダ/モデルの切替は AI_MODEL の文字列を変えるだけ。
# 自社のプロバイダ契約を使いたい場合 (BYOK) も、独自キーは Vercel ダッシュボードの
# AI Gateway → Bring Your Own Key に登録する → ここ (env) には増えない。
# すべてサーバー専用 — NEXT_PUBLIC_ にしないこと。
# AI_GATEWAY_API_KEY="xxxxxxxx"                  # Vercel ダッシュボードの Create Key で発行。秘密。Vercel デプロイ時は OIDC で省略可
# AI_MODEL="google/gemini-2.5-flash"             # creator/model 形式。未設定時は lib/ai.ts の既定 (gemini-2.5-flash) が使われる
#   切替例: google/gemini-2.5-pro / anthropic/claude-opus-4.8 / openai/gpt-5 / xai/grok-4.3
#   ※ Gateway のID表記はドット区切り(creator/claude-opus-4.8)。実在IDは AI Gateway の Models で当日確認
#   画像生成は別モデル・別 env。image-gen プラグインが担当
# AI_IMAGE_MODEL="google/imagen-4.0-fast-generate-001"   # 画像モデル。言語モデル(AI_MODEL)とは別。単価は AI Gateway の Models で当日確認
# AI_PROVIDER_ONLY="vertex"                       # 特定プロバイダに固定する場合のみ (カンマ区切り)。
#   例: 自分の Vertex AI (BYOK) を必ず使い、Google AI Studio 等へフォールバックさせない


# --- Firebase (firebase-backend が使用) ------------------------
# クライアント config (公開可・NEXT_PUBLIC_FIREBASE_*)
# NEXT_PUBLIC_FIREBASE_API_KEY="xxxx"
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="xxxx.firebaseapp.com"
# NEXT_PUBLIC_FIREBASE_PROJECT_ID="xxxx"
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="xxxx.appspot.com"
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="xxxx"
# NEXT_PUBLIC_FIREBASE_APP_ID="xxxx"
#
# Admin SDK (サーバー専用・秘密・FIREBASE_ADMIN_*。NEXT_PUBLIC_ には絶対置かない)
# Firestore / Auth / Storage の特権処理はこのサービスアカウントで行う。
# FIREBASE_ADMIN_PROJECT_ID="xxxx"
# FIREBASE_ADMIN_CLIENT_EMAIL="xxxx@xxxx.iam.gserviceaccount.com"
# 改行を含む秘密鍵は \n エスケープで 1 行化し、コード側で .replace(/\\n/g, '\n') する
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"


# --- GitHub (CI / Secrets 投入導線などで使用) ------------------
# GITHUB_TOKEN="ghp_xxxxxxxx"                    # サーバー専用


# ============================================================
# 以下は使うプラグインを入れたときだけコメントを外す (任意)
# ============================================================

# --- 監視 (observability-setup / Sentry) ----------------------
# SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"        # サーバー
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@xxxx.ingest.sentry.io/xxxx"  # クライアント
# SENTRY_AUTH_TOKEN="xxxx"                                     # ソースマップ用・秘匿

# --- 計測 (analytics-events) — 計測キーは公開前提 (秘密値ではない) ---
# GA4:
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# PostHog:
# NEXT_PUBLIC_POSTHOG_KEY="phc_xxxxxxxx"
# NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
